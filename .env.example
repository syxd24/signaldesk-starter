# Example only. Never put real credentials into this file or Git.
# The dashboard prompts for credentials and stores them in server memory only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_PRIVATE_TERMINAL_ONLY

# Optional for private installations: project refs that SignalDesk must refuse
# (comma-separated, e.g. your unrelated personal databases).
SIGNALDESK_BLOCKED_PROJECT_IDS=
